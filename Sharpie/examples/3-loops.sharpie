fn logNormal(int index) {
    stdlib.logln("I am now" index "years old");
}

fn logHappy(int index) {
    stdlib.logln("I AM FINALLY" index "YEARS OLD WIWIWIWIW");
}

fn main() { 
    var int start = 20;
    var int end = 31;
    var int limit = 27;

    for (index;start;end)

        do_if (index < limit) 
            logNormal(index);
        if_end

        do_if (index == 25) 
            logHappy(index);
        if_end

    for_end
}