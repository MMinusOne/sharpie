fn logAdultNameAndAge (string name int age) { 
  stdlib.logln("I am an adult");
  stdlib.logln("My name is" name);
  stdlib.logln("My age is" age);
}

fn logMinorNameAndAge (string name int age) {
  stdlib.logln("I am a minor);
  stdlib.logln("My name is" name);
  stdlib.logln("My age is" age);
}

fn main () {
  var string name = "Michael Salloum";
  var int age = 29;

  do_if (age < 18)
    logMinorNameAndAge(name age);
  if_end 

  do_if (age > 18)
    logAdultNameAndAge(name age);
  if_end
}
