fn logAdultNameAndAge(string name int age) { 
  log("I am an adult);
  newLine();
  log("My name is");
  newLine();
  log("My age is");
  log(age);
}

fn logMinorNameAndAge (string name int age) {
  log("I am a minor);
  newLine();
  log("My name is" name);
  newLine();
  log("My age is" age);
}

fn main () {
  var string name = "Michael Salloum";
  var int age = 29;

  do_if (age > 18)
    logMinorNameAndAge(name age);
  if_end
}
