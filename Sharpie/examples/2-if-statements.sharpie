fn logAdultNameAndAge () { 
  log("I am an adult);
  newLine();
  log("My name is" name);
  newLine();
  log("My age is" age);
}

fn logMinorNameAndAge () {
  log("I am a minor);
  newLine();
  log("My name is" name);
  newLine();
  log("My age is" age);
}

fn main () {
  var string name = "Michael Salloum";
  var int age = 9;

  do_if (age < 18)
    logMinorNameAndAge(name age);
  if_end 

  do_if (age > 18)
    newLine();
    logAdultNameAndAge(name age);
  if_end
}
